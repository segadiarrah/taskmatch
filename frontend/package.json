{
  "name": "taskmatch-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "TaskMatch.ai — AI-powered freelance task matching platform (Web UI)",
  "scripts": {
    "dev": "next dev --webpack --port 3000",
    "build": "next build --webpack",
    "start": "next start --port 3000",
    "lint": "eslint src",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run type-check && npm run lint && npm test && npm run check:ui && npm run check:metadata && npm run check:visual && npm run check:contrast",
    "check:contrast": "node scripts/check-design-contrast.mjs",
    "check:visual": "node scripts/check-visual-style.mjs",
    "check:localization": "node scripts/check-localization.mjs",
    "check:metadata": "node scripts/check-metadata.mjs",
    "check:ui": "node scripts/check-ui-contracts.mjs",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.50.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.400.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^2.12.0",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0"
  }
}
