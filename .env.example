# =============================================================================
# TaskMatch.ai — Environment Variables
# =============================================================================
# Copy this file to .env and fill in production values before deploying.
#   cp .env.example .env
# =============================================================================

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://taskmatch:taskmatch@postgres:5432/taskmatch

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Auth / JWT --------------------------------------------------------------
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- OpenAI (task matching engine) -------------------------------------------
OPENAI_API_KEY=sk-placeholder

# --- Stripe (payments) ------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_placeholder

# --- Credential vault --------------------------------------------------------
# Encrypts the access credentials a client shares for an installation-mode
# delivery. Falls back to SECRET_KEY when unset; either way it must not be the
# placeholder value, or the vault refuses to store anything rather than pretend
# the secrets are protected.
VAULT_SECRET_KEY=change-me-in-production
# Default lifetime of an access grant, and how many times it may be revealed
# before it has to be re-issued.
ACCESS_GRANT_TTL_HOURS=168
ACCESS_GRANT_MAX_REVEALS=5

# --- Pricing -----------------------------------------------------------------
# How long a quote is honoured before the job must be re-priced.
QUOTE_VALIDITY_DAYS=14
# Model whose rates are used to price LLM-routed tasks when no provider is
# enabled in the admin console.
PRICING_DEFAULT_MODEL=claude-sonnet-5

# --- Frontend ----------------------------------------------------------------
# Base URL for API calls. Call sites add the version segment themselves
# (`/v1/jobs/...`), so this must stop at `/api`.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
