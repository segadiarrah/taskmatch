# =============================================================================
# TaskMatch.ai — Environment Variables
# =============================================================================
# Copy this file to .env and fill in production values before deploying.
#   cp .env.example .env
# =============================================================================

# --- Database ----------------------------------------------------------------
ENV=development
POSTGRES_USER=taskmatch
POSTGRES_PASSWORD=taskmatch
POSTGRES_DB=taskmatch
DATABASE_URL=postgresql+asyncpg://taskmatch:taskmatch@postgres:5432/taskmatch

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Auth / JWT --------------------------------------------------------------
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- OpenAI (task matching engine) -------------------------------------------
OPENAI_API_KEY=
LLM_ENABLED=true

# --- Stripe (payments) ------------------------------------------------------
STRIPE_SECRET_KEY=

# --- Credential vault --------------------------------------------------------
# Encrypts the access credentials a client shares for an installation-mode
# delivery. Falls back to SECRET_KEY when unset; either way it must not be the
# placeholder value, or the vault refuses to store anything rather than pretend
# the secrets are protected.
# Leave unset to use SECRET_KEY, or configure a separate random key.
# VAULT_SECRET_KEY=
# Default lifetime of an access grant, and how many times it may be revealed
# before it has to be re-issued.
ACCESS_GRANT_TTL_HOURS=168
ACCESS_GRANT_MAX_REVEALS=5

# --- Pricing -----------------------------------------------------------------
# How long a quote is honoured before the job must be re-priced.
QUOTE_VALIDITY_DAYS=14
# Legacy estimates only. New Stripe LLM quotes require an enabled admin provider.
# FX below is a configured quote conversion, frozen on each accepted quote.
PRICING_DEFAULT_MODEL=gpt-6.1-sol
LLM_MODEL=gpt-6.1-sol
PRICING_USD_TO_EUR=0.92
# Explicit route for new IA/hybrid quotes; no fallback to other enabled providers.
EXECUTION_PROVIDER=openai
EXECUTION_MAX_INPUT_TOKENS=32000
EXECUTION_MAX_OUTPUT_TOKENS=16000
EXECUTION_MAX_ATTEMPTS=3

# --- Frontend ----------------------------------------------------------------
# Base URL for API calls. Call sites add the version segment themselves
# (`/v1/jobs/...`), so this must stop at `/api`.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=https://taskmatch.ai
NGINX_PORT=127.0.0.1:8091
CORS_ORIGINS=["http://localhost:8091","http://localhost:3000"]

# SMTP is optional; contact requests fail explicitly when no relay is configured.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@taskmatch.ai
# CONTACT_TO=support@example.com

# Stripe Checkout + Connect. Use dedicated TaskMatch webhook endpoints/secrets.
PAYMENT_MODE=stripe
STRIPE_MODE=test
STRIPE_API_VERSION=2024-06-20
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
BILLING_SITE_URL=https://taskmatch.ai
BILLING_WORKER_POLL_SECONDS=2
BILLING_OPERATION_LEASE_SECONDS=600
